<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- AR Fragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/arFragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Capture overlay: the hold before the capture of a run the user is waiting on.
         Declared before the controls so Close and the status card stay reachable over it. -->
    <FrameLayout
        android:id="@+id/captureOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:id="@+id/animationContainer"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/bgArImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/object_bg"
                    android:contentDescription="@string/ar_background" />

                <ImageView
                    android:id="@+id/phoneImage"
                    android:layout_width="58dp"
                    android:layout_height="77dp"
                    android:layout_gravity="center_vertical|start"
                    android:scaleType="fitCenter"
                    android:src="@drawable/phone_image"
                    android:contentDescription="@string/phone_scanning" />

            </FrameLayout>

            <TextView
                android:id="@+id/captureTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/capture_title_object"
                android:textColor="@color/ar_on"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/captureStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/ar_on_mid"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Server wait overlay: after the capture, while a run the user is waiting on is with the server -->
    <FrameLayout
        android:id="@+id/serverWaitOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/ar_accent" />

            <TextView
                android:id="@+id/serverWaitText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:textColor="@color/ar_on_mid"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Top left: the object code and the run status card, level with Reset and Close (16 + 36/2 =
         14 + 40/2 dp); a status chip above them only while there is something to say -->
    <LinearLayout
        android:id="@+id/topLeftColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/topActions"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/statusOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_ar_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_initializing"
                android:textAppearance="@style/TextAppearance.MultiSetSDK.ArStatus" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/objectCodeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_object_code_badge"
                android:fontFamily="monospace"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/ar_on"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="OBJ_001" />

            <com.multiset.xr.ui.runstatus.RunStatusCardView
                android:id="@+id/runStatusCard"
                android:layout_width="36dp"
                android:layout_height="36dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Start Tracking Button (bottom right): hidden under a run's overlay, disabled through a background run -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/trackButton"
        style="@style/Widget.MultiSetSDK.Fab.Capture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="30dp"
        android:contentDescription="@string/start_tracking"
        android:src="@drawable/ic_capture"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top-right actions: Reset appears once there is something to reset, then Close.
         Both live in one row so the status column can end against it while Reset is gone. -->
    <LinearLayout
        android:id="@+id/topActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/resetButton"
            style="@style/Widget.MultiSetSDK.Fab.Reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/reset_tracking"
            android:src="@drawable/ic_refresh"
            android:visibility="gone"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/closeButton"
            style="@style/Widget.MultiSetSDK.Fab.ArNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:fabSize="mini" />

    </LinearLayout>

    <!-- Mesh visibility (bottom left) — offered only once a mesh is actually in the scene -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/meshToggle"
        style="@style/Widget.MultiSetSDK.Button.MeshToggle"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:text="@string/mesh"
        android:visibility="gone"
        app:icon="@drawable/ic_cube"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- In the mesh toggle's place while an object's mesh downloads and is built -->
    <com.multiset.xr.ui.MeshLoadingBarView
        android:id="@+id/meshLoadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="30dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
