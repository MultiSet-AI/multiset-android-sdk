<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/arFragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top left, over the camera: the localization status, then GPS hint and the run status card -->
    <LinearLayout
        android:id="@+id/topLeftColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="124dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/statusOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_ar_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_initializing"
                android:textAppearance="@style/TextAppearance.MultiSetSDK.ArStatus" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/gpsIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/gps_indicator_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <View
                    android:id="@+id/gpsStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/gps_dot_inactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/gps"
                    android:textColor="@color/ar_on"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.multiset.xr.ui.runstatus.RunStatusCardView
                android:id="@+id/runStatusCard"
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The map sheet: collapsed to its handle, half open over the camera, or full screen -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:orientation="vertical"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.55"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/geopose_sheet_peek_height"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <FrameLayout
            android:id="@+id/dragHandleBar"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@color/instruction_ground">

            <View
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_sheet_handle" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="64dp"
                android:orientation="vertical">

                <!-- The latest GeoPose in words: where the arrow is and which way it points -->
                <LinearLayout
                    android:id="@+id/geoPoseCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ar_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/geopose_card_label"
                        android:textAppearance="@style/TextAppearance.MultiSetSDK.Label"
                        android:textColor="@color/ar_on_mid" />

                    <TextView
                        android:id="@+id/geoPoseHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/geopose_heading_none"
                        android:textAppearance="@style/TextAppearance.MultiSetSDK.ArMono"
                        app:drawableStartCompat="@drawable/ic_navigation"
                        app:drawableTint="@color/ar_good"
                        tools:text="274° W" />

                    <TextView
                        android:id="@+id/geoPoseCoordinates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="@string/geopose_waiting"
                        android:textColor="@color/ar_on"
                        android:textSize="13sp"
                        tools:text="12.913882, 77.639309" />

                    <TextView
                        android:id="@+id/geoPoseMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.MultiSetSDK.ArMeta"
                        android:visibility="gone"
                        tools:text="Alt 878.8 m · conf 0.76 · MAP_WAPT3WHLAH8H"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/noticeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ar_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/ar_warning"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="@string/geopose_notice_not_georeferenced"
                    tools:visibility="visible" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- After the sheet, so Close stays reachable over a full-screen map -->
    <LinearLayout
        android:id="@+id/topActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/resetButton"
            style="@style/Widget.MultiSetSDK.Fab.Reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/reset_scene"
            android:src="@drawable/ic_refresh"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/closeButton"
            style="@style/Widget.MultiSetSDK.Fab.ArNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:fabSize="mini" />
    </LinearLayout>

    <!-- Map controls sit at the screen's bottom rather than in the sheet, which runs below it half open -->
    <TextView
        android:id="@+id/attributionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_ar_chip"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/ar_on_mid"
        android:textSize="11sp"
        tools:text="© OpenStreetMap contributors" />

    <LinearLayout
        android:id="@+id/mapControlsStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="30dp"
        android:orientation="horizontal">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/recenterButton"
            style="@style/Widget.MultiSetSDK.Fab.ArNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/geopose_recenter"
            android:src="@drawable/ic_my_location"
            app:fabSize="mini" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapControlsEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="30dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/zoomInButton"
            style="@style/Widget.MultiSetSDK.Fab.ArNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/geopose_zoom_in"
            android:src="@drawable/ic_add"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/zoomOutButton"
            style="@style/Widget.MultiSetSDK.Fab.ArNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/geopose_zoom_out"
            android:src="@drawable/ic_remove"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/mapStyleButton"
            style="@style/Widget.MultiSetSDK.Fab.ArNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/geopose_map_style"
            android:src="@drawable/ic_layers"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fullscreenButton"
            style="@style/Widget.MultiSetSDK.Fab.ArNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:contentDescription="@string/geopose_full_screen"
            android:src="@drawable/ic_fullscreen"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/localizeButton"
            style="@style/Widget.MultiSetSDK.Fab.Capture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/localize"
            android:src="@drawable/ic_capture" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
