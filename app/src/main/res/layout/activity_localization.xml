<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- AR Fragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/arFragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Single-Frame Capture Overlay (shown during single-frame capture) -->
    <FrameLayout
        android:id="@+id/singleFrameOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/ar_brand" />

            <TextView
                android:id="@+id/singleFrameStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/capturing"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Multi-Frame Capture Overlay (shown during multi-frame capture) -->
    <FrameLayout
        android:id="@+id/multiFrameOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Animation Container -->
            <FrameLayout
                android:id="@+id/animationContainer"
                android:layout_width="200dp"
                android:layout_height="100dp"
                android:layout_marginBottom="20dp">

                <!-- Background AR Image -->
                <ImageView
                    android:id="@+id/bgArImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bg_ar"
                    android:contentDescription="@string/ar_background" />

                <!-- Animated Phone Image -->
                <ImageView
                    android:id="@+id/phoneImage"
                    android:layout_width="58dp"
                    android:layout_height="77dp"
                    android:layout_gravity="center_vertical|start"
                    android:scaleType="fitCenter"
                    android:src="@drawable/phone_image"
                    android:contentDescription="@string/phone_scanning" />

            </FrameLayout>

            <!-- Instruction Text -->
            <TextView
                android:id="@+id/instructionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/localization_instruction"
                android:textColor="@color/ar_on_mid"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <!-- Status Text -->
            <TextView
                android:id="@+id/multiFrameStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/capturing_frames"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- API Loading Overlay (shown while waiting for API response) -->
    <FrameLayout
        android:id="@+id/apiLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/ar_brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/localizing"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Status Overlay (top) - Hidden by default -->
    <LinearLayout
        android:id="@+id/statusOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_ar_chip"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/topActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tracking_initializing"
            android:textAppearance="@style/TextAppearance.MultiSetSDK.ArStatus" />

        <TextView
            android:id="@+id/localizationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ready_to_localize"
            android:textAppearance="@style/TextAppearance.MultiSetSDK.ArMeta" />

    </LinearLayout>

    <!-- Mesh visibility (bottom left) — offered only once a mesh is actually in the scene -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/meshToggle"
        style="@style/Widget.MultiSetSDK.Button.MeshToggle"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:text="@string/mesh"
        android:visibility="gone"
        app:icon="@drawable/ic_cube"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Localize Button (bottom right) - Always visible -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/localizeButton"
        style="@style/Widget.MultiSetSDK.Fab.Capture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="30dp"
        android:contentDescription="@string/localize"
        android:src="@drawable/ic_capture"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top-right actions: Reset appears once there is something to reset, then Close.
         Both live in one row so the status chip can end against it while Reset is gone. -->
    <LinearLayout
        android:id="@+id/topActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/resetButton"
            style="@style/Widget.MultiSetSDK.Fab.Reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/reset_scene"
            android:src="@drawable/ic_refresh"
            android:visibility="gone"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/closeButton"
            style="@style/Widget.MultiSetSDK.Fab.ArNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:fabSize="mini" />

    </LinearLayout>

    <!-- GPS Status Indicator -->
    <LinearLayout
        android:id="@+id/gpsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/gps_indicator_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusOverlay">

        <!-- GPS Icon/Dot -->
        <View
            android:id="@+id/gpsStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/gps_dot_inactive" />

        <!-- GPS Label -->
        <TextView
            android:id="@+id/gpsStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="GPS"
            android:textColor="@color/ar_on"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Background Localization Progress (subtle line at bottom) -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/backgroundProgressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/ar_brand"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
