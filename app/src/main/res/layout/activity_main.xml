<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <!-- ── Header ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="12dp">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="76dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sdk_logo" />

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/multiset_vps_samples"
                    android:textAppearance="@style/TextAppearance.MultiSetSDK.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/app_tagline"
                    android:textAppearance="@style/TextAppearance.MultiSetSDK.Subtitle" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_mid" />
        </FrameLayout>

        <!-- ── Auth ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/authButton"
            style="@style/Widget.MultiSetSDK.Button.Tonal.Brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/authenticate"
            app:icon="@drawable/ic_lock" />

        <TextView
            android:id="@+id/authStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_chip_success"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="9dp"
            android:text="@string/authenticated"
            android:textColor="@color/success_ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_check"
            app:drawableTint="@color/success_ink" />

        <!-- ── Localization ── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MultiSetSDK.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_tile_brand"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_map"
                        app:tint="@color/brand_ink" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/localization_label"
                        android:textAppearance="@style/TextAppearance.MultiSetSDK.CardTitle"
                        android:textColor="@color/brand_ink" />
                </LinearLayout>

                <!-- Map code (shown when configured) -->
                <TextView
                    android:id="@+id/mapCodeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/rounded_purple_tint"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:textAppearance="@style/TextAppearance.MultiSetSDK.Mono"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_map"
                    app:drawableTint="@color/brand_ink" />

                <TextView
                    android:id="@+id/noMapText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/no_map_configured"
                    android:textAppearance="@style/TextAppearance.MultiSetSDK.Meta"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/mode_label"
                    android:textAppearance="@style/TextAppearance.MultiSetSDK.Label" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/modeToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/singleFrameButton"
                        style="@style/Widget.MultiSetSDK.Button.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/single_frame" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/multiFrameButton"
                        style="@style/Widget.MultiSetSDK.Button.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/multi_frame" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/localizationButton"
                    style="@style/Widget.MultiSetSDK.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/start_localization" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Object tracking ── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MultiSetSDK.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_tile_accent"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_cube"
                        app:tint="@color/accent_ink" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/object_tracking"
                        android:textAppearance="@style/TextAppearance.MultiSetSDK.CardTitle"
                        android:textColor="@color/accent_ink" />

                    <TextView
                        android:id="@+id/objectCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_badge_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/text_mid"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/noObjectCodesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/no_object_codes"
                    android:textAppearance="@style/TextAppearance.MultiSetSDK.Meta" />

                <LinearLayout
                    android:id="@+id/objectCodesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/rounded_teal_tint"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/objectTrackingButton"
                    style="@style/Widget.MultiSetSDK.Button.Tonal.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/start_object_tracking" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Footer ── -->
        <TextView
            android:id="@+id/instructionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="28dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/footer_credentials"
            android:textColor="@color/text_low"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
