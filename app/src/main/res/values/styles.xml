<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Type ──────────────────────────────────────────────────────────── -->

    <style name="TextAppearance.MultiSetSDK.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_hi</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.MultiSetSDK.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_mid</item>
    </style>

    <style name="TextAppearance.MultiSetSDK.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.MultiSetSDK.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_low</item>
    </style>

    <style name="TextAppearance.MultiSetSDK.Meta" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_mid</item>
    </style>

    <style name="TextAppearance.MultiSetSDK.Mono" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/text_mid</item>
    </style>

    <style name="TextAppearance.MultiSetSDK.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_hi</item>
    </style>

    <style name="TextAppearance.MultiSetSDK.DialogBody" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:textColor">@color/text_mid</item>
    </style>

    <!-- ── Buttons ───────────────────────────────────────────────────────── -->

    <style name="Widget.MultiSetSDK.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="iconTint">@color/on_brand</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Object tracking: the accent reads as an identity mark, not a second primary. -->
    <style name="Widget.MultiSetSDK.Button.Tonal.Accent" parent="Widget.MultiSetSDK.Button.Primary">
        <item name="backgroundTint">@color/accent_container</item>
        <item name="android:textColor">@color/accent_ink</item>
        <item name="iconTint">@color/accent_ink</item>
        <item name="rippleColor">@color/accent_ink</item>
    </style>

    <style name="Widget.MultiSetSDK.Button.Tonal.Brand" parent="Widget.MultiSetSDK.Button.Primary">
        <item name="backgroundTint">@color/brand_container</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="iconTint">@color/brand_ink</item>
        <item name="rippleColor">@color/brand_ink</item>
    </style>

    <style name="Widget.MultiSetSDK.Button.Segment" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/segment_stroke</item>
        <item name="backgroundTint">@color/segment_fill</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="rippleColor">@color/brand_ink</item>
    </style>

    <style name="Widget.MultiSetSDK.Dialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/brand_container</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="rippleColor">@color/brand_ink</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.MultiSetSDK.Dialog.Button.Text" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_mid</item>
    </style>

    <!-- ── Containers ────────────────────────────────────────────────────── -->

    <style name="Widget.MultiSetSDK.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ── AR chrome (always light-on-dark) ──────────────────────────────── -->

    <style name="Widget.MultiSetSDK.Fab.ArNeutral" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/ar_scrim</item>
        <item name="tint">@color/ar_on</item>
        <item name="elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="borderWidth">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.MultiSetSDK.Fab.Capture" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/ar_brand</item>
        <item name="tint">@color/ar_on</item>
        <item name="fabCustomSize">68dp</item>
        <item name="maxImageSize">32dp</item>
        <item name="elevation">6dp</item>
        <item name="borderWidth">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.MultiSetSDK.Fab.Reset" parent="Widget.MultiSetSDK.Fab.ArNeutral">
        <item name="backgroundTint">@color/ar_scrim</item>
        <item name="tint">@color/ar_warning</item>
    </style>

    <style name="ShapeAppearance.MultiSetSDK.MeshToggle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="Widget.MultiSetSDK.Button.MeshToggle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/ar_scrim</item>
        <item name="android:textColor">@color/ar_on</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="iconTint">@color/ar_on</item>
        <item name="iconSize">18dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MultiSetSDK.MeshToggle</item>
    </style>

    <style name="TextAppearance.MultiSetSDK.ArStatus" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ar_on</item>
    </style>

    <style name="TextAppearance.MultiSetSDK.ArMeta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ar_on_mid</item>
    </style>
</resources>
