// Editing this file changes nothing until it is recompiled into
// app/src/main/res/raw/radial_reveal_material.filamat with matc from Filament 1.57.1 — the
// release Sceneform pulls. Anything else produces a MAT_VERSION the runtime rejects:
//   matc -a opengl -a vulkan -a metal -p mobile -o app/src/main/res/raw/radial_reveal_material.filamat \
//        app/src/main/assets/materials/radial_reveal.mat
//
// Port of iOS RadialRevealShader.metal.
// reveal = (centre xyz in world space, current radius in metres); radius 0 draws nothing.
material {
    name : RadialReveal,
    shadingModel : unlit,
    blending : transparent,
    culling : back,
    depthWrite : false,
    parameters : [
        { type : float4, name : reveal }
    ]
}

fragment {
    float gridFactor(vec3 pos, vec3 n, float gridSize, float lineWidth) {
        vec3 a = abs(n);
        vec2 g;
        if (a.y > a.x && a.y > a.z) {
            g = pos.xz / gridSize;
        } else if (a.x > a.z) {
            g = pos.yz / gridSize;
        } else {
            g = pos.xy / gridSize;
        }
        vec2 f = fract(abs(g));
        vec2 d = min(f, 1.0 - f);
        return 1.0 - smoothstep(0.0, lineWidth, min(d.x, d.y));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 centre = materialParams.reveal.xyz;
        float radius = materialParams.reveal.w;
        // getWorldPosition() is camera-relative in Filament; the reveal centre is not.
        vec3 pos = getUserWorldPosition();
        float dist = distance(pos, centre);
        if (dist > radius) {
            material.baseColor = vec4(0.0);
            return;
        }
        vec3 baseColor = vec3(0.357, 0.114, 0.6);
        float baseAlpha = 0.39;
        vec3 glowColor = vec3(1.0, 0.227, 0.0);
        float glowWidth = max(radius * 0.10, 0.1);
        float glow = clamp(1.0 - clamp((radius - dist) / glowWidth, 0.0, 1.0), 0.0, 1.0);
        glow *= glow;
        vec3 n = normalize(cross(dFdx(pos), dFdy(pos)));
        float grid = gridFactor(pos, n, 1.0, 0.02);
        vec3 color = mix(baseColor, vec3(1.0, 1.0, 0.0), grid);
        float alpha = max(baseAlpha, grid * 0.8);
        color += glowColor * glow * 2.0;
        alpha = max(alpha, glow);
        // Transparent blending expects premultiplied alpha.
        material.baseColor = vec4(color * alpha, alpha);
    }
}
