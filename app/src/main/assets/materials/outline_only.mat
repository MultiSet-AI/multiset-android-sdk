// Editing this file changes nothing until it is recompiled into
// app/src/main/res/raw/outline_only_material.filamat with matc from Filament 1.57.1 — the
// release Sceneform pulls. Anything else produces a MAT_VERSION the runtime rejects:
//   matc -a opengl -p mobile -o app/src/main/res/raw/outline_only_material.filamat \
//        app/src/main/assets/materials/outline_only.mat
//
// Port of the iOS OutlineShader.metal, itself a port of Unity's Custom/UniversalOutlineOnly.
// The tuning values iOS keeps as `constant` stay constants here too, so they cannot drift
// between the two SDKs through a caller passing a different number.
material {
    name : OutlineOnly,
    shadingModel : unlit,
    blending : transparent,
    culling : front,
    depthWrite : false,
    requires : [
        tangents
    ],
    variables : [
        shellPosition,
        shellNormal
    ],
    parameters : [
        { type : float4, name : outlineColor },
        { type : float,  name : outlineWidth },
        { type : float,  name : animTime }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.shellPosition = getPosition();
        material.shellNormal = vec4(material.worldNormal, 0.0);

        // Unity's vertex pass: push every vertex out along its normal by the outline width.
        // The node transform is rigid, so a world-space offset of this length matches the
        // model-space offset iOS applies.
        material.worldPosition.xyz += material.worldNormal * materialParams.outlineWidth;
    }
}

fragment {
    // OutlineMat.mat — the same numbers as iOS OutlineShader.metal
    const float kGlowIntensity  = 4.0;
    const float kSparkSpeed     = 3.0;
    const float kSparkFrequency = 8.0;
    const float kSparkIntensity = 3.0;
    const float kRimPower       = 2.0;
    const float kRimIntensity   = 0.7;

    float hash2d(vec2 p) {
        return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
    }

    float noise2d(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        float a = hash2d(i);
        float b = hash2d(i + vec2(1.0, 0.0));
        float c = hash2d(i + vec2(0.0, 1.0));
        float d = hash2d(i + vec2(1.0, 1.0));
        vec2 u = f * f * (3.0 - 2.0 * f);
        return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec3 modelPos = variable_shellPosition.xyz;

        // The shell is drawn inside-out, so its normals point away from the viewer; the rim
        // Unity computes on the front-culled shell is the same quantity with the sign flipped.
        vec3 normal = normalize(variable_shellNormal.xyz);
        vec3 viewDir = normalize(getWorldCameraPosition() - getWorldPosition());
        float facing = abs(dot(normal, viewDir));
        float rim = pow(clamp(1.0 - facing, 0.0, 1.0), kRimPower) * kRimIntensity;

        float time = materialParams.animTime * kSparkSpeed;

        vec2 sparkCoord1 = modelPos.xy * kSparkFrequency;
        float spark1 = pow(clamp(noise2d(sparkCoord1 + time * 0.5), 0.0, 1.0), 2.0);

        vec2 sparkCoord2 = modelPos.xz * kSparkFrequency * 1.7;
        float spark2 = pow(clamp(noise2d(sparkCoord2 - time * 0.3), 0.0, 1.0), 3.0);

        float wave = pow(clamp(sin(modelPos.y * 10.0 - time * 3.0) * 0.5 + 0.5, 0.0, 1.0), 2.0);

        float sparkMask = step(0.6, hash2d(floor(sparkCoord1)));
        float combinedSpark = max(mix(spark1, spark2, 0.5) * sparkMask, wave * 0.3);
        float pulse = sin(time * 2.0) * 0.3 + 0.7;
        float animation = (1.0 + combinedSpark * kSparkIntensity) * pulse;

        vec3 finalColor = materialParams.outlineColor.rgb * kGlowIntensity * animation
                          * (rim * 0.7 + 0.3);
        float finalAlpha = (rim * 0.6 + 0.4) * clamp(animation * 0.5, 0.0, 1.0)
                           * materialParams.outlineColor.a;

        material.baseColor = vec4(finalColor, finalAlpha);
    }
}
